# ─── Application ───────────────────────────────────────────────────────────────
PORT=3000

# ─── PostgreSQL Database ────────────────────────────────────────────────────────
DB_NAME=diagnostic_db
DB_USER=postgres
DB_PASS=postgres
# For local development without Docker, use: DB_HOST=localhost
# When running via docker-compose, DB_HOST is overridden to 'db' by the compose file
DB_HOST=localhost
DB_PORT=5432

# ─── JWT ────────────────────────────────────────────────────────────────────────
# REQUIRED: the application will refuse to start if this is not set.
# Use a long, random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-secret
